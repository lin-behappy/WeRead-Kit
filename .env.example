# 微信读书 Web 服务配置

# 监听地址，默认 127.0.0.1
WEREAD_HOST=127.0.0.1

# 监听端口，默认 8080
WEREAD_PORT=8080

# SQLite 数据库路径，默认 data/weread.db
WEREAD_DB=data/weread.db

# 可选：设置后启用 Web 登录；留空则无需登录
WEREAD_USERNAME=
WEREAD_PASSWORD=

# 奖励领取端平台标识(pf 参数)；默认安卓，避免奖励被记为 iOS 端
# 安卓真值: wechat_wx-2001-android-100-weread    iOS 真值: weread_wx-2001-iap-2001-iphone
# WEREAD_PF=wechat_wx-2001-android-100-weread
